{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["icn1"],
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "node class/scripts/db-build.js && node class/scripts/site.js public && next build",
  "ignoreCommand": "test -f class/scripts/ignore-build.sh || exit 1; sh class/scripts/ignore-build.sh"
}
